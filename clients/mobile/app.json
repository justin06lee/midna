{
  "expo": {
    "name": "midna",
    "slug": "midna",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "sh.midna.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "10.77.0.0/16": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "100.64.0.0/10": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "ts.net": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2",
      "appleTeamId": "65UN46K6FA"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-sqlite",
      "expo-image",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "midna asks for Face ID before you answer an approval."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "midna sends the photos and videos you pick to your midna.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ]
  }
}
