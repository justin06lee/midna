{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "midna",
  "version": "0.2.1",
  "identifier": "sh.midna.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5190",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "midna",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#f3f3f4",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Your personal assistant, from your desk",
    "longDescription": "midna is a proactive personal assistant that lives on a computer you own. This app finds your machines over makima or Tailscale, sets midna up on the one you pick, and is where you talk to it.",
    "macOS": { "minimumSystemVersion": "11.0" },
    "externalBin": ["binaries/midna"],
    "resources": { "kits/*": "kits/" }
  }
}
