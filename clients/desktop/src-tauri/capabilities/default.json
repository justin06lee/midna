{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the window may reach: the app's own commands, dragging itself by its title bar, following the chosen appearance, notifications, copying a pairing code, opening a link, and the login item. Talking to midna itself is plain HTTP to the host, with a device token.",
  "windows": ["main", "pill", "approval"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:window:allow-is-focused",
    "notification:default",
    "clipboard-manager:allow-write-text",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "tg://*" }]
    }
  ]
}
